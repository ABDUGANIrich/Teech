# Copy to .env.local for local development only. This file is not production config.
# Vercel uses its own Production environment variables; .env.local is not uploaded.
# Public Supabase project details (never put service-role keys here)
NEXT_PUBLIC_SUPABASE_URL=
# Accepts a Supabase publishable key or legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only
# Accepts a Supabase secret key or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Exact allowlist; only :free models permitted. No paid fallback.
OPENROUTER_ALLOWED_MODELS=nvidia/nemotron-3.5-super-vl:free
# Local browser origin. On Vercel Production use https://teech-nu.vercel.app instead.
APP_URL=http://127.0.0.1:3000
# Generate a random secret with at least 32 characters.
ANONYMOUS_HASH_SECRET=
USER_DAILY_LIMIT=100
ANONYMOUS_DAILY_LIMIT=10
# Safe default for the 50/day tier. Set to 900 ONLY after checking your 1000/day entitlement.
APP_DAILY_LIMIT=40
PERSONAL_MINUTE_LIMIT=10
# Teacher mode uses these SAME limits. Its 22-provider-attempt lifetime session
# cap is enforced in migration 004; it has no separate model allowance or model key.
# Optional automatic supporting-material retrieval for topic-only Teacher lessons.
# Keep this server-side. At most 2 requests per action and 8 per lesson.
# Authenticated Keenable includes 100,000 free requests/month and 10 requests/sec.
# Apply 20261031111719_keenable_free_limits.sql: shared atomic 10/rolling-second
# and 100,000/rolling-31-day caps, including failures; no keyless/paid fallback.
# Keep purchased credits/auto top-up disabled for this free-only deployment.
KEENABLE_API_KEY=
